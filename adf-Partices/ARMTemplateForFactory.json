		{
			"name": "[concat(parameters('factoryName'), '/DF_Orders_Raw_To_Curated_ass')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Raw_Orders_output",
								"type": "DatasetReference"
							},
							"name": "RawOrders"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Curated_Orders_ass",
								"type": "DatasetReference"
							},
							"name": "sink"
						}
					],
					"transformations": [
						{
							"name": "flatten1"
						},
						{
							"name": "flatten2"
						},
						{
							"name": "filter1"
						}
					],
					"scriptLines": [
						"parameters{",
						"     p_watermark as string ('2026-08-20 00:00:00')",
						"}",
						"source(output(",
						"          has_more as boolean,",
						"          next_cursor as string,",
						"          orders as (created_at as string, customer as (email as string, id as short), id as short, line_items as (price as double, quantity as short, sku as string)[])[]",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     inferDriftedColumnTypes: true,",
						"     ignoreNoFilesFound: false,",
						"     documentForm: 'documentPerLine') ~> RawOrders",
						"RawOrders foldDown(unroll(orders),",
						"     mapColumn(",
						"          created_at = orders.created_at,",
						"          customer_id = orders.customer.id,",
						"          customer_email = orders.customer.email,",
						"          line_items = orders.line_items,",
						"          order_id = orders.id",
						"     ),",
						"     skipDuplicateMapInputs: false,",
						"     skipDuplicateMapOutputs: false) ~> flatten1",
						"flatten1 foldDown(unroll(line_items),",
						"     mapColumn(",
						"          customer_id,",
						"          created_at,",
						"          customer_email,",
						"          sku = line_items.sku,",
						"          quantity = line_items.quantity,",
						"          price = line_items.price,",
						"          order_id",
						"     ),",
						"     skipDuplicateMapInputs: false,",
						"     skipDuplicateMapOutputs: false) ~> flatten2",
						"flatten2 filter(!isNull(created_at) &&",
						"toTimestamp(created_at) > toTimestamp($p_watermark)) ~> filter1",
						"filter1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sink"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_Raw_Orders_output')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_Curated_Orders_ass')]"
			]
		},
